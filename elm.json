        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/html": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.1.3 <= v < 2.0.0",
        "elm/parser": "1.1.0 <= v < 2.0.0",
        "elm/regex": "1.0.0 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0",
        "elm-community/list-extra": "8.7.0 <= v < 9.0.0",
        "elm-community/maybe-extra": "5.3.0 <= v < 6.0.0",
        "elm-community/result-extra": "2.4.0 <= v < 3.0.0",
        "maca/elm-rose-tree": "1.2.1 <= v < 2.0.0",
        "pablohirafuji/elm-syntax-highlight": "3.7.1 <= v < 4.0.0",
        "toastal/either": "3.6.3 <= v < 4.0.0"
